# Cabin writes compile_commands.json per profile; clangd only looks in
# ancestors and their build/ directories, so point it at the dev profile.
CompileFlags:
  CompilationDatabase: build/dev
  # GCC accepts the standard headers' long double declarations under
  # -mno-80387 and only rejects actual use; clang rejects the declarations.
  Remove: [-mno-80387]
  Add:
    - -std=c++26
